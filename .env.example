# ─── Copy to .env before starting the stack: cp .env.example .env ───────────────
# These are local development credentials for a throwaway Docker stack. A real
# deployment would inject the same variable names from a secrets manager
# (AWS Secrets Manager / Azure Key Vault / Vault) instead of a dotenv file.
#
# To run the pipeline from the host shell, export them first:
#     set -a && source .env && set +a

# ─── Microsoft SQL Server 2025 (primary warehouse) ─────────────────────────────
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DB=warehouse
MSSQL_USER=sa
# Must satisfy the SQL Server password policy (8+ chars, 3 of 4 character classes).
# Required: the dbt profile and the loader both fail loudly if it is unset.
MSSQL_PASSWORD=P@ssword#@219#
MSSQL_HOST_PORT=1433

# ─── PostgreSQL 16 (portability target + Airflow metadata database) ────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=warehouse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
AIRFLOW_DB=airflow

# ─── Apache Airflow ────────────────────────────────────────────────────────────
AIRFLOW_IMAGE_NAME=apache/airflow:2.9.1
AIRFLOW_UID=50000
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_EMAIL=admin@example.com
AIRFLOW_HOST_PORT=8080
# Target the DAG runs dbt against: mssql (default) or postgres.
DBT_TARGET=mssql
_PIP_ADDITIONAL_REQUIREMENTS=

# ─── MinIO / S3 bronze object storage (optional) ───────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=bronze
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# ─── Metabase BI ───────────────────────────────────────────────────────────────
METABASE_HOST_PORT=3000

# ─── dbt ───────────────────────────────────────────────────────────────────────
DBT_PROFILES_DIR=/opt/airflow/dbt
# Log verbosity for the ingestion package: DEBUG | INFO | WARNING | ERROR
INGESTION_LOG_LEVEL=INFO
